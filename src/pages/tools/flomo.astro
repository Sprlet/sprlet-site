---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Base title="flomo 笔记" description="把 flomo 网页版整个嵌在这里，不跳走也能记。">
  <Header slot="header" />

  <div class="wrap" style="max-width:1100px">
    <div class="page-head" style="margin-bottom:1rem">
      <p class="article-kicker">
        <a href="/tools" style="color:inherit">工具</a>
        <span aria-hidden="true">/</span>
        <span>笔记</span>
      </p>
      <h1>flomo 笔记</h1>
      <p>整个 flomo 网页版嵌在这一页里，不用来回跳。登录态走 flomo 自己的，第一次进来可能要登一下。</p>
    </div>

    <div class="flomo-frame">
      <div class="flomo-bar">
        <span class="flomo-dot" aria-hidden="true"></span>
        <span class="flomo-src">v.flomoapp.com</span>
        <span class="flomo-spacer"></span>
        <a href="https://v.flomoapp.com/" target="_blank" rel="noopener">新窗口打开 ↗</a>
      </div>
      <iframe
        src="https://v.flomoapp.com/"
        title="flomo"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allow="clipboard-read; clipboard-write"
      ></iframe>
    </div>
  </div>

  <Footer slot="footer" />
</Base>

<style>
  .flomo-frame {
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-elev, #fff);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.06);
    margin-bottom: 4rem;
  }
  .flomo-bar {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--muted, #6b7280);
  }
  .flomo-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgb(34 197 94 / 0.15);
  }
  .flomo-spacer { flex: 1; }
  .flomo-bar a { color: inherit; text-decoration: none; border-bottom: 1px solid transparent; }
  .flomo-bar a:hover { border-bottom-color: currentColor; }
  .flomo-frame iframe {
    display: block;
    width: 100%;
    height: min(78vh, 900px);
    min-height: 520px;
    border: 0;
    background: #fff;
  }
  @media (max-width: 640px) {
    .flomo-frame iframe { height: 72vh; min-height: 460px; }
  }
</style>
