---
import Tool from '../../layouts/Tool.astro';
---

<Tool slug="flomo">
  <div class="flomo-frame">
    <div class="flomo-bar">
      <span class="flomo-dot" aria-hidden="true"></span>
      <span class="flomo-src">v.flomoapp.com</span>
      <span class="flomo-spacer"></span>
      <a href="https://v.flomoapp.com/" target="_blank" rel="noopener">新窗口打开 ↗</a>
    </div>
    <iframe
      src="https://v.flomoapp.com/"
      title="flomo"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allow="clipboard-read; clipboard-write"
    ></iframe>
  </div>
</Tool>

<style>
  .flomo-frame {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--bg-elev);
    box-shadow: var(--shadow);
  }
  .flomo-bar {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: var(--bg-soft);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  .flomo-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--r-lg);
    background: var(--accent-2);
    box-shadow: 0 0 0 0.1875rem color-mix(in oklab, var(--accent-2) 15%, transparent);
  }
  .flomo-spacer { flex: 1; }
  .flomo-bar a { color: inherit; text-decoration: none; border-bottom: 1px solid transparent; }
  .flomo-bar a:hover { border-bottom-color: currentColor; }
  .flomo-frame iframe {
    display: block;
    width: 100%;
    height: min(78vh, 56.25rem);
    min-height: 32.5rem;
    border: 0;
  }
  @media (max-width: 40rem) {
    .flomo-frame iframe { height: 72vh; min-height: 28.75rem; }
  }
</style>
