---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { tools } from '../../data/tools';

const icons: Record<string, string> = {
  braces: '<path d="M8 4H6a2 2 0 0 0-2 2v3a2 2 0 0 1-2 2 2 2 0 0 1 2 2v3a2 2 0 0 0 2 2h2"/><path d="M16 4h2a2 2 0 0 1 2 2v3a2 2 0 0 0 2 2 2 2 0 0 0-2 2v3a2 2 0 0 1-2 2h-2"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  code: '<path d="m9 18-6-6 6-6M15 6l6 6-6 6"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><path d="M14 3h7v7M3 14v7h7"/>',
  palette: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M12 3v6.5M12 14.5V21"/>',
  book: '<path d="M4 5a2 2 0 0 1 2-2h6v18H6a2 2 0 0 1-2-2Z"/><path d="M20 5a2 2 0 0 0-2-2h-6v18h6a2 2 0 0 0 2-2Z"/>',
  note: '<path d="M5 3h11l4 4v14H5Z"/><path d="M8 9h8M8 13h8M8 17h5"/>',
  shield: '<path d="M12 3 5 6v6c0 4.4 3 8.3 7 9 4-0.7 7-4.6 7-9V6Z"/><path d="m9 12 2 2 4-4"/>',
};
---

<Base title="工具" description="自己天天用的小工具，纯浏览器运行，不上传任何数据。">
  <Header slot="header" />

  <div class="wrap">
    <div class="page-head">
      <h1>小工具</h1>
      <p>都是我自己天天用的。全部在浏览器里跑，输入的东西不会离开这台设备。</p>
    </div>

    <div class="page-body reveal">
      <ul class="card-grid reveal">
        {tools.map((t) => (
          <li class="card">
            <span class="card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                set:html={icons[t.icon] ?? icons.code}></svg>
            </span>
            <h2 class="card-title">{t.title}</h2>
            <p class="card-desc">{t.long}</p>
            <a class="card-foot" href={t.external ?? `/tools/${t.slug}`}
              target={t.external ? '_blank' : undefined}
              rel={t.external ? 'noopener' : undefined}>
              {t.tag} · 打开 {t.external ? '↗' : '→'}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <Footer slot="footer" />
</Base>
