---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { tools, getTool } from '../data/tools';

export interface Props { slug: string; wide?: boolean }
const { slug, wide = false } = Astro.props;
const tool = getTool(slug)!;
const others = tools.filter((t) => t.slug !== slug).slice(0, 3);
---

<Base title={tool.title} description={tool.long}>
  <Header slot="header" />

  <div class="wrap">
    <div class="page-head">
      <p class="article-kicker">
        <a href="/tools" style="color:inherit">工具</a>
        <span aria-hidden="true">/</span>
        <span>{tool.tag}</span>
      </p>
      <h1>{tool.title}</h1>
      <p>{tool.long}</p>
    </div>

    <div class="page-body" style={`max-width:${wide ? "1100px" : "820px"}`}>
      <slot />

      {others.length > 0 && (
        <div style="margin-top:3.5rem;padding-top:1.6rem;border-top:1px solid var(--line)">
          <div class="section-head" style="border:none;padding-bottom:0;margin-bottom:1rem">
            <h2 style="font-size:var(--step-1)">还有别的</h2>
            <a class="more" href="/tools">全部工具 →</a>
          </div>
          <ul class="card-grid" style="grid-template-columns:repeat(auto-fill,minmax(200px,1fr))">
            {others.map((t) => (
              <li class="card">
                <h3 class="card-title" style="font-size:var(--step-0)">{t.title}</h3>
                <p class="card-desc">{t.desc}</p>
                <a class="card-foot" href={t.external ?? `/tools/${t.slug}`}
                  target={t.external ? '_blank' : undefined}
                  rel={t.external ? 'noopener' : undefined}>
                  打开 {t.external ? '↗' : '→'}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>

  <Footer slot="footer" />
</Base>
